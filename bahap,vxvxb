local function MR()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isKiller(plr)
    if not plr or plr == LP then return false end
    if plr.Team then
        local tn = string.lower(plr.Team.Name)
        if string.find(tn, "kill") or string.find(tn, "murder") then return true end
    end
    local char = plr.Character
    if char then
        for _, a in ipairs({"IsKiller","Killer","isKiller"}) do
            if char:GetAttribute(a) == true then return true end
        end
    end
    return false
end

local function getInfo(plr, targetPart)
    local char = plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local root = char:FindFirstChild(targetPart) or char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local cam = WS.CurrentCamera
    if not cam then return nil end
    local myRoot = MR()
    if not myRoot then return nil end
    local dist = (myRoot.Position - root.Position).Magnitude
    if dist > CFG.MaxDist then return nil end
    local sp, onScreen = cam:WorldToViewportPoint(root.Position)
    if not onScreen then return nil end
    local vp = cam.ViewportSize
    local dx = sp.X - vp.X / 2
    local dy = sp.Y - vp.Y / 2
    return {
        plr = plr, char = char, root = root, hum = hum,
        screenPos = Vector2.new(sp.X, sp.Y),
        worldPos = root.Position,
        distFromCenter = math.sqrt(dx*dx + dy*dy),
        distance = dist,
        healthPct = math.floor((hum.Health / hum.MaxHealth) * 100),
    }
end

