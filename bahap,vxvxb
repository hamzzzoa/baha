local function makeSlider(parent, label, minV, maxV, initV, cb, y, isFloat)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -20, 0, 44)
    row.Position = UDim2.new(0, 10, 0, y)
    row.BackgroundColor3 = COL.bgCard
    row.BackgroundTransparency = 0.3
    row.BorderSizePixel = 0
    row.ZIndex = 1002
    row.Active = true
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(1, -16, 0, 14)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = COL.textDim
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 1003
    lbl.Active = false

    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, -20, 0, 16)
    track.Position = UDim2.new(0, 10, 0, 22)
    track.BackgroundColor3 = COL.bgInput
    track.BorderSizePixel = 0
    track.ZIndex = 1003
    track.Active = false
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)
    local ts = Instance.new("UIStroke", track)
    ts.Color = COL.border
    ts.Thickness = 1

    local initRel = (initV - minV) / (maxV - minV)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(initRel, 0, 1, 0)
    fill.BackgroundColor3 = COL.accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 1004
    fill.Active = false
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local valueL = Instance.new("TextLabel", track)
    valueL.Size = UDim2.new(1, -8, 1, 0)
    valueL.BackgroundTransparency = 1
    valueL.Text = (isFloat and string.format("%.2f", initV) or tostring(initV)) .. "/" .. tostring(maxV)
    valueL.TextColor3 = COL.text
    valueL.Font = Enum.Font.GothamBold
    valueL.TextSize = 10
    valueL.TextXAlignment = Enum.TextXAlignment.Right
    valueL.ZIndex = 1005
    valueL.Active = false

    -- Invisible button buat handle drag
    local dragBtn = Instance.new("TextButton", track)
    dragBtn.Size = UDim2.new(1, 0, 1, 0)
    dragBtn.BackgroundTransparency = 1
    dragBtn.Text = ""
    dragBtn.ZIndex = 1010
    dragBtn.Active = true
    dragBtn.Selectable = true

    local dragging = false
    local function update(xPos)
        local rel = (xPos - track.AbsolutePosition.X) / track.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        local v = minV + (maxV - minV) * rel
        if isFloat then v = math.floor(v * 100) / 100
        else v = math.floor(v) end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        valueL.Text = (isFloat and string.format("%.2f", v) or tostring(v)) .. "/" .. tostring(maxV)
        if cb then pcall(cb, v) end
    end

    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    dragBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
end

